/* ============================================
   TaskDispatcher — 暗色主题
   主色调:#007AFF (blue accent)
   ============================================ */

/* ====== 全局背景 ====== */
QMainWindow {
        background-color:#1E1E2E;
}
QDialog {
        background-color:#242436;
}
QLabel {
        color:#D4D4D4;
}
QMenuBar {
        background-color:#1E1E2E;
        color:#D4D4D4;
        border-bottom:1px solid #404058;
}
QMenuBar::item:selected {
        background-color:rgba(0,122,255,0.18);
}
/* ====== QComboBox ====== */
QComboBox {
        background-color:#28283C;
        color:#D4D4D4;
        border:1px solid #404058;
        padding:3px 7px;
        border-radius:3px;
}
QComboBox::drop-down {
        subcontrol-origin:padding;
        subcontrol-position:top right;
        width:30px;
        border-left:1px solid #404058;
}
QComboBox::down-arrow {
        image:url(:/combox_arrow.png);
        width:16px;
        height:16px;
}
QComboBox:hover {
        border-color:#007AFF;
}
QComboBox::drop-down:hover {
        border-color:#007AFF;
}
QComboBox::down-arrow:hover {
        image:url(:/combox_arrow_007aff.png);
}
QComboBox QAbstractItemView {
        border:1px solid #007AFF;
        background:#28283C;
        color:#D4D4D4;
        selection-color:#FFFFFF;
        outline:0;
}
QComboBox QAbstractItemView::item:selected {
        background-color:#007AFF;
        color:#FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
        background-color:rgba(0,122,255,0.22);
        color:#D4D4D4;
}
QComboBox:disabled {
        background-color:#333348;
        color:#707080;
        border-color:#505060;
}
/* ====== QListView ====== */
QListView {
	background-color:#28283C;
	color:#D4D4D4;
	border:none;
	font-size:10pt;
	outline:none;
}
QListView::item {
	padding:6px 0px;
}
QListView::item:hover {
	background-color:rgba(0,122,255,0.08);
}
QListView::item:selected {
	background-color:rgba(0,122,255,0.18);
	color:#FFFFFF;
}
/* ====== QListWidget ====== */
QListWidget {
	background-color:#28283C;
	color:#D4D4D4;
	border:1px solid #404058;
	border-radius:3px;
	font-size:10pt;
	outline:none;
	padding:2px;
}
QListWidget::item {
	padding:6px 4px;
}
QListWidget::item:hover {
	background-color:rgba(0,122,255,0.08);
}
QListWidget::item:selected {
	background-color:rgba(0,122,255,0.18);
	color:#FFFFFF;
}
/* ====== QLineEdit ====== */
QLineEdit {
	background-color:#28283C;
	color:#D4D4D4;
	border:1px solid #404058;
	border-radius:3px;
	padding:3px;
}
QLineEdit:hover {
	border:1px solid #007AFF;
}
/* ====== QTextEdit ====== */
QTextEdit {
	background-color:#28283C;
	color:#D4D4D4;
	border:1px solid #404058;
	border-radius:3px;
}
QTextEdit:hover {
	border:1px solid #007AFF;
}
/* ====== QTimeEdit ====== */
QTimeEdit {
	background-color:#28283C;
	color:#D4D4D4;
	border:1px solid #404058;
	border-radius:3px;
	padding:3px;
}
QTimeEdit:hover {
	border:1px solid #007AFF;
}
QTimeEdit:disabled {
	background-color:#333348;
	color:#707080;
	border-color:#505060;
}
QTimeEdit::up-button {
	subcontrol-origin:border;
	subcontrol-position:top right;
	width:20px;
	border-left:1px solid #404058;
	border-bottom:1px solid #404058;
	border-top-right-radius:3px;
}
QTimeEdit::up-button:hover {
	border-color:#007AFF;
	background-color:rgba(0,122,255,0.10);
}
QTimeEdit::up-arrow {
	image:url(:/spin_up.png);
	width:10px;
	height:10px;
}
QTimeEdit::up-button:hover QTimeEdit::up-arrow {
	image:url(:/spin_up_007aff.png);
}
QTimeEdit::down-button {
	subcontrol-origin:border;
	subcontrol-position:bottom right;
	width:20px;
	border-left:1px solid #404058;
	border-bottom-right-radius:3px;
}
QTimeEdit::down-button:hover {
	border-color:#007AFF;
	background-color:rgba(0,122,255,0.10);
}
QTimeEdit::down-arrow {
	image:url(:/spin_down.png);
	width:10px;
	height:10px;
}
QTimeEdit::down-button:hover QTimeEdit::down-arrow {
	image:url(:/spin_down_007aff.png);
}
/* ====== QRadioButton ====== */
QRadioButton {
	color:#D4D4D4;
	spacing:6px;
}
QRadioButton::indicator {
	width:12px;
	height:12px;
	border-radius:7px;
	border:1px solid #404058;
	background-color:#28283C;
}
QRadioButton::indicator:hover {
	border-color:#007AFF;
}
QRadioButton::indicator:checked {
	border-color:#007AFF;
	background-color:#007AFF;
}
QRadioButton::indicator:checked:hover {
	border-color:#0060DB;
	background-color:#0060DB;
}
QRadioButton:disabled {
	color:#707080;
}
QRadioButton::indicator:disabled {
	border-color:#505068;
	background-color:#333348;
}
QRadioButton::indicator:checked:disabled {
	border-color:#505068;
	background-color:#505068;
}
/* ====== QPushButton ====== */
QPushButton {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #007AFF,stop:1 #0060DB);
        color:#FFFFFF;
        border:none;
        padding:5px 10px;
        border-radius:4px;
}
QPushButton:hover {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0070EA,stop:1 #0056CC);
}
QPushButton:pressed {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0060DB,stop:1 #004AAD);
}
QPushButton:disabled {
        background:#28283C;
	color:#909090;
	border:1px solid #404058;
}
/* 取消按钮 */
QPushButton#cancelButton {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #3A3A50,stop:1 #2E2E42);
        color:#D4D4D4;
        border:1px solid #505068;
}
QPushButton#cancelButton:hover {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #454560,stop:1 #38384E);
        border-color:#007AFF;
}