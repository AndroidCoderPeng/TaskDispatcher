/* ============================================
   TaskDispatcher — 亮色主题
   主色调:#007AFF (blue accent)
   ============================================ */

/* ====== 全局背景 ====== */
QMainWindow {
        background-color:#F5F5F5;
}
QDialog {
        background-color:#F5F5F5;
}
QLabel {
        color:#333333;
}
QMenuBar {
        background-color:#F5F5F5;
		color:#333333;
		border-bottom:1px solid #E0E0E0;
}
QMenuBar::item:selected {
        background-color:rgba(0,122,255,0.12);
}
/* ====== QComboBox ====== */
QComboBox {
        background-color:#F5F5F5;
		color:#333333;
		border:1px solid #ABABAB;
		padding:3px 7px;
		border-radius:3px;
}
QComboBox::drop-down {
        subcontrol-origin:padding;
		subcontrol-position:top right;
		width:30px;
		border-left:1px solid #ABABAB;
}
QComboBox::down-arrow {
        image:url(:/combox_arrow.png);
		width:16px;
		height:16px;
}
QComboBox:hover {
        border-color:#007AFF;
}
QComboBox::drop-down:hover {
        border-color:#007AFF;
}
QComboBox::down-arrow:hover {
        image:url(:/combox_arrow_007aff.png);
}
QComboBox QAbstractItemView {
        border:1px solid #007AFF;
		background:#FFFFFF;
		color:#333333;
		selection-color:#FFFFFF;
		outline:0;
}
QComboBox QAbstractItemView::item:selected {
        background-color:#007AFF;
		color:#FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
        background-color:rgba(0,122,255,0.18);
		color:#333333;
}
QComboBox:disabled {
        background-color:#E0E0E0;
		color:#A0A0A0;
		border-color:#A0A0A0;
}
/* ====== QListView ====== */
QListView {
	background-color:#FFFFFF;
	color:#333333;
	border:none;
	font-size:10pt;
	outline:none;
}
QListView::item {
	padding:6px 0px;
}
QListView::item:hover {
	background-color:rgba(0,122,255,0.06);
}
QListView::item:selected {
	background-color:rgba(0,122,255,0.15);
	color:#333333;
}
/* ====== QPushButton ====== */
QPushButton {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #007AFF,stop:1 #0060DB);
	color:#FFFFFF;
	border:none;
	padding:5px 10px;
	border-radius:4px;
}
QPushButton:hover {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0070EA,stop:1 #0056CC);
}
QPushButton:pressed {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0060DB,stop:1 #004AAD);
}
QPushButton:disabled {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #B0B0B0,stop:1 #9A9A9A);
	color:#E0E0E0;
}
/* 取消按钮 */
QPushButton#cancelButton {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F2F2F2);
	color:#333333;
	border:1px solid #A0A0A0;
}
QPushButton#cancelButton:hover {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FAFAFA,stop:1 #E8E8ED);
	border-color:#007AFF;
}