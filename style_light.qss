/* ============================================
   TaskDispatcher — 亮色主题
   主色调:#007AFF (blue accent)
   ============================================ */

/* ====== 全局背景 ====== */
QMainWindow {
        background-color:#F5F5F5;
}
QDialog {
        background-color:#F5F5F5;
}
QLabel {
        color:#333333;
}
QMenuBar {
        background-color:#F5F5F5;
		color:#333333;
		border-bottom:1px solid #E0E0E0;
}
QMenuBar::item:selected {
        background-color:rgba(0,122,255,0.12);
}
/* ====== QListWidget ====== */
QListWidget {
	background-color:#FFFFFF;
	color:#333333;
	border:1px solid #ABABAB;
	border-radius:3px;
	font-size:10pt;
	outline:none;
	padding:2px;
}
QListWidget::item {
	padding:6px 4px;
}
QListWidget::item:hover {
	background-color:rgba(0,122,255,0.06);
}
QListWidget::item:selected {
	background-color:rgba(0,122,255,0.15);
	color:#333333;
}
/* ====== QLineEdit ====== */
QLineEdit {
	background-color:#FFFFFF;
	color:#333333;
	border:1px solid #ABABAB;
	border-radius:3px;
	padding:3px;
}
QLineEdit:hover {
	border:1px solid #007AFF;
}
/* ====== QTextEdit ====== */
QTextEdit {
	background-color:#FFFFFF;
	color:#333333;
	border:1px solid #ABABAB;
	border-radius:3px;
}
QTextEdit:hover {
	border:1px solid #007AFF;
}
/* ====== QTimeEdit ====== */
QTimeEdit {
	background-color:#FFFFFF;
	color:#333333;
	border:1px solid #ABABAB;
	border-radius:3px;
	padding:3px;
}
QTimeEdit:hover {
	border:1px solid #007AFF;
}
QTimeEdit:disabled {
	background-color:#E0E0E0;
	color:#A0A0A0;
	border-color:#A0A0A0;
}
QTimeEdit::up-button {
	subcontrol-origin:border;
	subcontrol-position:top right;
	width:20px;
	border-left:1px solid #ABABAB;
	border-bottom:1px solid #ABABAB;
	border-top-right-radius:3px;
}
QTimeEdit::up-button:hover {
	border-color:#007AFF;
	background-color:rgba(0,122,255,0.08);
}
QTimeEdit::up-arrow {
	image:url(:/spin_up.png);
	width:10px;
	height:10px;
}
QTimeEdit::up-button:hover QTimeEdit::up-arrow {
	image:url(:/spin_up_007aff.png);
}
QTimeEdit::down-button {
	subcontrol-origin:border;
	subcontrol-position:bottom right;
	width:20px;
	border-left:1px solid #ABABAB;
	border-bottom-right-radius:3px;
}
QTimeEdit::down-button:hover {
	border-color:#007AFF;
	background-color:rgba(0,122,255,0.08);
}
QTimeEdit::down-arrow {
	image:url(:/spin_down.png);
	width:10px;
	height:10px;
}
QTimeEdit::down-button:hover QTimeEdit::down-arrow {
	image:url(:/spin_down_007aff.png);
}
/* ====== QRadioButton ====== */
QRadioButton {
	color:#333333;
	spacing:6px;
}
QRadioButton::indicator {
	width:12px;
	height:12px;
	border-radius:7px;
	border:1px solid #ABABAB;
	background-color:#FFFFFF;
}
QRadioButton::indicator:hover {
	border-color:#007AFF;
}
QRadioButton::indicator:checked {
	border-color:#007AFF;
	background-color:#007AFF;
}
QRadioButton::indicator:checked:hover {
	border-color:#0060DB;
	background-color:#0060DB;
}
QRadioButton:disabled {
	color:#A0A0A0;
}
QRadioButton::indicator:disabled {
	border-color:#C0C0C0;
	background-color:#E8E8E8;
}
QRadioButton::indicator:checked:disabled {
	border-color:#B0B0B0;
	background-color:#B0B0B0;
}
/* ====== QPushButton ====== */
QPushButton {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #007AFF,stop:1 #0060DB);
	color:#FFFFFF;
	border:none;
	padding:5px 10px;
	border-radius:4px;
}
QPushButton:hover {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0070EA,stop:1 #0056CC);
}
QPushButton:pressed {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0060DB,stop:1 #004AAD);
}
QPushButton:disabled {
        background:#E0E0E0;
	color:#A0A0A0;
	border:1px solid #A0A0A0;
}
/* 取消按钮 */
QPushButton#cancelButton {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F2F2F2);
	color:#333333;
	border:1px solid #A0A0A0;
}
QPushButton#cancelButton:hover {
        background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FAFAFA,stop:1 #E8E8ED);
	border-color:#007AFF;
}